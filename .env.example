# ════════════════════════════════════════════════════════════
# AIVA Environment Configuration Template (.env.example)
# Copy this file to .env and adjust for your environment.
# ════════════════════════════════════════════════════════════

# ================================
# 基本配置 (簡化版 - 移除冗餘變數)
# ================================
ENVIRONMENT=development
LOG_LEVEL=INFO
AUTO_MIGRATE=1

# ================================
# 資料庫配置 (PostgreSQL + pgvector)
# ================================
# ✅ 統一格式: 簡潔命名 (符合 12-factor app)
# 移除 AIVA_ 前綴,降低配置複雜度

# PostgreSQL 連線配置
DATABASE_URL=postgresql://postgres:aiva123@localhost:5432/aiva_db
DB_TYPE=postgres

# PostgreSQL 詳細配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aiva_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=aiva123

# ================================
# 消息隊列配置 (RabbitMQ)
# ================================
# ✅ 統一使用無前綴格式 (符合 12-factor app)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

MQ_EXCHANGE=aiva.topic
MQ_DLX=aiva.dlx

# ================================
# 整合模組配置 (Integration Module)
# ================================
# 只需設置根目錄，子路徑自動推導 (見 defaults.py)
AIVA_INTEGRATION_DATA_DIR=C:/D/fold7/AIVA-git/data/integration

# ================================
# Redis 配置 (已移除 - 未實際使用)
# ================================
# Redis 在代碼中未被使用 (0 個 import redis)，已移除以降低複雜度
# 如需啟用，請取消註釋以下配置：
# REDIS_URL=redis://:aiva_redis_password@localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ================================
# API 配置 (僅部署 API Gateway 時需要)
# ================================
# API_KEY=your_api_key_here

# ================================
# 監控配置 (使用預設值，見 defaults.py)
# ================================
# ENABLE_PROMETHEUS=true
# RATE_LIMIT_RPS=20
# RATE_LIMIT_BURST=60

# ================================
# CORS 配置 (僅部署 Web UI 時需要)
# ================================
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
