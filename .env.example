# AIVA v2.0 環境配置範本
# 複製此文件為 .env 並根據你的環境調整設定

# ================================
# ✅ v2.0 架構說明
# ================================
# v2.0 使用數據合約驅動架構（AICommand/AICommandResult）
# 已移除外部依賴：RabbitMQ、PostgreSQL、Redis、Neo4j
# 所有數據存儲使用本地檔案系統（SQLite、JSON）

# ================================
# 安全配置
# ================================
# API Gateway 主密鑰
API_KEY=your_super_secure_api_key_here

# Integration 模組認證令牌
INTEGRATION_TOKEN=your_integration_secure_token

# JWT 配置
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALG=HS256

# ================================
# CORS 和安全
# ================================
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ================================
# 速率限制
# ================================
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=60

# ================================
# 監控和觀察性
# ================================
ENABLE_PROM=1
LOG_LEVEL=INFO

# ================================
# AI 引擎配置
# ================================
MODEL_CACHE_SIZE=100
BIO_INPUT_SIZE=512
BIO_HIDDEN_SIZE=256

# ================================
# 掃描配置
# ================================
SCAN_TIMEOUT=300
SCAN_MAX_RETRIES=3
SCAN_CONCURRENT=10

# ================================
# 數據目錄
# ================================
DATA_DIR=/workspaces/AIVA/data
AIVA_INTEGRATION_DATA_DIR=C:/D/fold7/AIVA-git/data/integration

# ================================
# 核心監控
# ================================
CORE_MONITOR_INTERVAL=30

# ================================
# 功能開關
# ================================
ENABLE_STRATEGY_GEN=true
ENABLE_PROMETHEUS=true

# ================================
# OAST 服務
# ================================
OAST_URL=http://localhost:8084

# ================================
# 開發設定 (僅開發環境)
# ================================
# ENVIRONMENT=development
# DEBUG=1
# RELOAD=1