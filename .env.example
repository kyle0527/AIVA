# ════════════════════════════════════════════════════════════
# AIVA v7.1 Environment Configuration Template
# Copy this file to .env and adjust for your environment
# Updated: 2026-02-06
# ════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────
ENVIRONMENT=development          # development | production | offline | continuous
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── Security & Authentication ────────────────────────────
API_KEY=your_super_secure_api_key_here
INTEGRATION_TOKEN=your_integration_secure_token
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALG=HS256

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=60

# ── RabbitMQ (Message Queue) ─────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=aiva_exchange

# ── Database ─────────────────────────────────────────────
# SQLite (default) or PostgreSQL
# AIVA_DB_URL=sqlite:///data/database/aiva.db
# AIVA_DB_URL=postgresql+asyncpg://user:pass@localhost:5432/aiva

# ── Data Directories ─────────────────────────────────────
DATA_DIR=./data
AIVA_DATA_DIR=./data
AIVA_INTEGRATION_DATA_DIR=./data/integration

# ── Scanning ─────────────────────────────────────────────
SCAN_TIMEOUT=300
SCAN_MAX_RETRIES=3
SCAN_CONCURRENT=10
AIVA_TARGET_SENSITIVITY=0.5      # 0.0 (passive) ~ 1.0 (aggressive)
AIVA_ALLOW_ATTACK=0              # 1 = enable active attack capabilities
AIVA_ALLOWED_RISK=L0,L1          # Allowed risk levels

# ── AI / Neural Network ─────────────────────────────────
MODEL_CACHE_SIZE=100
BIO_INPUT_SIZE=512
BIO_HIDDEN_SIZE=256

# ── Feature Toggles ─────────────────────────────────────
ENABLE_STRATEGY_GEN=true
ENABLE_PROMETHEUS=true
AIVA_USE_INTEGRATED_PATHS=true

# ── Core Monitoring ──────────────────────────────────────
CORE_MONITOR_INTERVAL=30         # seconds

# ── OAST Service ─────────────────────────────────────────
OAST_URL=http://localhost:8084
OAST_SERVICE_URL=http://localhost:8083

# ── External API Keys (optional) ─────────────────────────
# SHODAN_API_KEY=your_shodan_key
# VIRUSTOTAL_API_KEY=your_virustotal_key
# NVD_API_KEY=your_nvd_key
# ABUSEIPDB_API_KEY=your_abuseipdb_key
# GOOGLE_API_KEY=your_google_key
# GOOGLE_SEARCH_ENGINE_ID=your_cx_id
# GITHUB_TOKEN=your_github_token
# OPENAI_API_KEY=your_openai_key

# ── Backup (optional) ───────────────────────────────────
# AIVA_AUTO_BACKUP=false
# AIVA_BACKUP_DIR=./backups
# AIVA_BACKUP_INTERVAL=24        # hours
# AIVA_BACKUP_KEEP_DAYS=30

# ── Worker IDs (optional, auto-generated if empty) ──────
# XSS_WORKER_ID=
# SSRF_WORKER_ID=
