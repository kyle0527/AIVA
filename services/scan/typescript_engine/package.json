{
  "name": "aiva-scan-node",
  "version": "1.0.0",
  "description": "AIVA Dynamic Scanning Engine with Playwright",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "playwright": "^1.41.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.19.27",
    "@types/pino": "^7.0.4",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "inversify": "^8.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.2.0",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^1.2.0"
  }
}
