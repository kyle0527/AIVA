{
  "id": "xss.scan.web",
  "name": "XSS Web Scanner",
  "description": "掃描網頁XSS漏洞|支援DOM分析|檢測反射型存儲型",
  "command_template": "python -m xss_scan --url {target} --depth {depth} --timeout {timeout}",
  "parameters": {
    "target": {
      "description": "目標網站URL",
      "type": "string",
      "required": true
    },
    "depth": {
      "description": "掃描深度",
      "type": "integer",
      "required": false,
      "default": 3,
      "min_value": 1,
      "max_value": 10
    },
    "timeout": {
      "description": "超時時間（秒）",
      "type": "integer",
      "required": false,
      "default": 30,
      "min_value": 10,
      "max_value": 300
    }
  },
  "tags": ["security", "web", "xss", "scanner"],
  "timeout": 300,
  "category": "security.scanner",
  "language": "python",
  "version": "1.0.0"
}
