{
  "meta": {
    "flow_id": 3,
    "tool_name": "Session State Manager - Get Context",
    "description": "獲取會話上下文資訊，用於策略調整和決策支持（702 flows 的核心狀態管理器）",
    "version": "1.0.0",
    "language": "python",
    "module": "service_backbone",
    "tags": ["session", "state", "context", "strategy"]
  },
  "ai_cognitive": {
    "primary_capability": "session_context_query",
    "risk_level": "low",
    "tags": {
      "required": ["context", "state"],
      "boost": ["strategy", "decision", "analysis"],
      "exclude": ["write", "destructive"]
    },
    "cognitive_insights": {
      "適用場景": "AI 決策前查詢歷史、策略調整參考、動態學習輸入",
      "決策考量": "提供歷史結果、指紋資訊、目標資訊供 AI 分析",
      "風險評估": "只讀操作，是 840 flows 中 84% 流程的核心依賴"
    }
  },
  "execution": {
    "type": "python_function",
    "command_template": {
      "module": "services.core.aiva_core.service_backbone.state.session_state_manager",
      "class": "SessionStateManager",
      "method": "get_session_context",
      "instantiate": true
    },
    "timeout_seconds": 5,
    "working_directory": "C:/D/fold7/AIVA-git",
    "environment_variables": {}
  },
  "parameters": {
    "context_mapping": {
      "scan_id": "scan_id"
    },
    "tunable": {
      "detail_level": {
        "type": "integer",
        "description": "上下文詳細程度：1=基本狀態, 5=完整歷史+指紋",
        "min": 1,
        "max": 5,
        "mapping_strategy": "linear"
      }
    }
  },
  "examples": [
    {
      "scenario": "AI 決策前獲取最小上下文",
      "context_data": {
        "scan_id": "scan_20231225_001"
      },
      "ai_intensity": 0.2,
      "expected_command": "python -m services.core.aiva_core.service_backbone.state.session_state_manager get_context --scan-id 'scan_20231225_001' --detail-level 2",
      "expected_output": {
        "scan_id": "scan_20231225_001",
        "current_status": "phase1_scanning",
        "completed_tasks": 15,
        "total_tasks": 50,
        "findings_count": 3
      }
    },
    {
      "scenario": "策略調整需要完整歷史",
      "context_data": {
        "scan_id": "scan_20231225_001"
      },
      "ai_intensity": 0.9,
      "expected_command": "python -m services.core.aiva_core.service_backbone.state.session_state_manager get_context --scan-id 'scan_20231225_001' --detail-level 5",
      "expected_output": {
        "scan_id": "scan_20231225_001",
        "current_status": "phase1_scanning",
        "completed_tasks": 15,
        "total_tasks": 50,
        "findings_count": 3,
        "waf_detected": true,
        "previous_results": ["...", "..."],
        "target_info": {"url": "https://example.com"},
        "fingerprints": {"technologies": ["nginx", "php"]}
      }
    }
  ]
}
