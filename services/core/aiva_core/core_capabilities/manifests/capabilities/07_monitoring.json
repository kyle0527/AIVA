{
  "meta": {
    "flow_id": 7,
    "tool_name": "System Monitoring - Metrics Collection",
    "description": "系統監控服務，收集性能指標和健康數據（5 flows 入口點）",
    "version": "1.0.0",
    "language": "python",
    "module": "service_backbone",
    "tags": ["monitoring", "metrics", "performance"]
  },
  "ai_cognitive": {
    "primary_capability": "system_monitoring",
    "risk_level": "low",
    "tags": {
      "required": ["monitoring", "metrics"],
      "boost": ["performance", "health", "observability"],
      "exclude": ["write", "destructive"]
    },
    "cognitive_insights": {
      "適用場景": "性能監控、資源追蹤、系統健康檢查",
      "決策考量": "可調整採樣頻率和詳細度",
      "風險評估": "只讀監控，輕微性能影響"
    }
  },
  "execution": {
    "binary_path": "python",
    "command_template": "python -m services.core.aiva_core.service_backbone.monitoring.monitoring collect --metrics '{metrics_list}' --interval {sampling_interval} --duration {duration}",
    "timeout_seconds": 300,
    "working_directory": "C:/D/fold7/AIVA-git",
    "environment_variables": {}
  },
  "parameters": {
    "context_mapping": {
      "metrics_list": "requested_metrics"
    },
    "tunable": {
      "sampling_interval": {
        "type": "integer",
        "description": "採樣間隔（秒）：低強度=長間隔，高強度=高頻採樣",
        "min": 60,
        "max": 5,
        "mapping_strategy": "inverse"
      },
      "duration": {
        "type": "integer",
        "description": "監控持續時間（秒）：低強度=短期，高強度=長期監控",
        "min": 60,
        "max": 3600,
        "mapping_strategy": "exponential"
      }
    }
  },
  "examples": [
    {
      "scenario": "快速健康檢查（低強度）",
      "context_data": {
        "requested_metrics": "cpu,memory"
      },
      "ai_intensity": 0.2,
      "expected_command": "python -m services.core.aiva_core.service_backbone.monitoring.monitoring collect --metrics 'cpu,memory' --interval 49 --duration 124"
    },
    {
      "scenario": "標準性能監控（中強度）",
      "context_data": {
        "requested_metrics": "cpu,memory,disk,network"
      },
      "ai_intensity": 0.5,
      "expected_command": "python -m services.core.aiva_core.service_backbone.monitoring.monitoring collect --metrics 'cpu,memory,disk,network' --interval 33 --duration 463"
    },
    {
      "scenario": "深度分析監控（高強度）",
      "context_data": {
        "requested_metrics": "cpu,memory,disk,network,processes,connections"
      },
      "ai_intensity": 0.9,
      "expected_command": "python -m services.core.aiva_core.service_backbone.monitoring.monitoring collect --metrics 'cpu,memory,disk,network,processes,connections' --interval 10 --duration 2669"
    }
  ]
}
