{
  "meta": {
    "flow_id": 8,
    "tool_name": "Initial Surface Analyzer - Attack Surface Discovery",
    "description": "初始攻擊面分析器，發現和評估潛在攻擊向量（3 flows 入口點）",
    "version": "1.0.0",
    "language": "python",
    "module": "core_capabilities",
    "tags": ["analysis", "attack-surface", "reconnaissance"]
  },
  "ai_cognitive": {
    "primary_capability": "attack_surface_analysis",
    "risk_level": "low",
    "tags": {
      "required": ["analysis", "reconnaissance"],
      "boost": ["discovery", "mapping", "assessment"],
      "exclude": ["exploit", "intrusive"]
    },
    "cognitive_insights": {
      "適用場景": "初始偵察、攻擊面評估、漏洞發現前置",
      "決策考量": "可調整掃描深度和範圍",
      "風險評估": "被動分析，無侵入性"
    }
  },
  "execution": {
    "binary_path": "python",
    "command_template": "python -m services.core.aiva_core.core_capabilities.analysis.initial_surface analyze --target '{target}' --depth {scan_depth} --threads {thread_count}",
    "timeout_seconds": 600,
    "working_directory": "C:/D/fold7/AIVA-git",
    "environment_variables": {}
  },
  "parameters": {
    "context_mapping": {
      "target": "target_url"
    },
    "tunable": {
      "scan_depth": {
        "type": "integer",
        "description": "掃描深度：低強度=淺層，高強度=深度遞歸",
        "min": 1,
        "max": 5,
        "mapping_strategy": "linear"
      },
      "thread_count": {
        "type": "integer",
        "description": "並發線程數：低強度=單線程，高強度=高並發",
        "min": 1,
        "max": 10,
        "mapping_strategy": "exponential"
      }
    }
  },
  "examples": [
    {
      "scenario": "快速表面掃描",
      "context_data": {
        "target_url": "https://example.com"
      },
      "ai_intensity": 0.2,
      "expected_command": "python -m services.core.aiva_core.core_capabilities.analysis.initial_surface analyze --target 'https://example.com' --depth 1 --threads 1"
    },
    {
      "scenario": "標準深度分析",
      "context_data": {
        "target_url": "https://example.com"
      },
      "ai_intensity": 0.5,
      "expected_command": "python -m services.core.aiva_core.core_capabilities.analysis.initial_surface analyze --target 'https://example.com' --depth 3 --threads 3"
    },
    {
      "scenario": "全面深度掃描",
      "context_data": {
        "target_url": "https://example.com"
      },
      "ai_intensity": 0.9,
      "expected_command": "python -m services.core.aiva_core.core_capabilities.analysis.initial_surface analyze --target 'https://example.com' --depth 5 --threads 9"
    }
  ]
}
