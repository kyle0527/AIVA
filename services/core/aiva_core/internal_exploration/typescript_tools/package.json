{
  "name": "aiva-ts-tools",
  "version": "2.0.0",
  "description": "AIVA TypeScript AST Analysis & Stitching Tool - All-in-One Solution",
  "type": "module",
  "main": "ts2mermaid.ts",
  "scripts": {
    "build": "tsc",
    "analyze": "ts-node ts2mermaid.ts --input=../../ --output=./analysis_output",
    "analyze:full": "ts-node ts2mermaid.ts --input=../../ --output=./full_analysis",
    "test": "ts-node ts2mermaid.ts --input=. --output=./test_output"
  },
  "keywords": [
    "typescript",
    "ast",
    "mermaid",
    "flowchart",
    "analysis",
    "classifier",
    "cli"
  ],
  "author": "AIVA Team",
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2"
  }
}
