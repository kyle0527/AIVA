{
  "name": "ts2mermaid",
  "version": "1.0.0",
  "type": "module",
  "description": "TypeScript AST 解析與 Mermaid 流程圖產生工具",
  "main": "ts2mermaid.ts",
  "scripts": {
    "build": "tsc ts2mermaid.ts",
    "start": "ts-node ts2mermaid.ts",
    "analyze:typescript": "ts-node ts2mermaid.ts -i ../../../services/scan/engines/typescript_engine -o ../../../docs/diagrams/typescript",
    "analyze:custom": "ts-node ts2mermaid.ts"
  },
  "keywords": [
    "typescript",
    "ast",
    "mermaid",
    "flowchart",
    "code-analysis"
  ],
  "author": "AIVA Team",
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "ts-node": "^10.9.2"
  }
}
