{
  "unified_capability_format": {
    "concept": "統一能力描述 - 跨語言通用格式",
    "principle": "AI通過能力描述理解和推理，不暴露技術實現細節",
    
    "capability_structure": {
      "intent": "what the capability does - 做什麼",
      "scope": "where it applies - 適用範圍", 
      "method": "how it operates - 運作方式",
      "outcome": "what it produces - 產出結果"
    }
  },
  
  "cross_language_examples": {
    "web_injection_testing": {
      "intent": "inject_malicious_payload",
      "scope": "web_input_fields", 
      "method": "automated_fuzzing",
      "outcome": "vulnerability_evidence",
      "available_in": ["python_flow_x", "rust_func_y", "go_func_z"]
    },
    
    "server_side_request_forgery": {
      "intent": "trigger_internal_requests", 
      "scope": "url_parameters",
      "method": "payload_injection",
      "outcome": "internal_network_access",
      "available_in": ["python_flow_70", "rust_ssrf_engine"]
    },
    
    "authentication_bypass": {
      "intent": "circumvent_access_controls",
      "scope": "login_mechanisms", 
      "method": "credential_manipulation",
      "outcome": "unauthorized_access",
      "available_in": ["python_flow_1", "go_auth_bypass"]
    }
  },
  
  "ai_reasoning_template": {
    "when_ai_needs": "web_injection_testing",
    "ai_can_choose_from": [
      "python implementation via flow",
      "rust implementation via function", 
      "go implementation via function"
    ],
    "ai_considers": [
      "target complexity",
      "performance requirements", 
      "current context"
    ],
    "ai_generates": "optimal execution command based on reasoning"
  },
  
  "execution_abstraction": {
    "ai_thinks": "I need to test for SQL injection on this web form",
    "system_maps": "web_injection_testing -> python_flow_15 OR rust_sqli_engine",
    "system_generates": "python aiva_external_executor.py --lang python --flow 15 --target {url}",
    "ai_never_sees": "SqlInjectionScanner.detect_vulnerabilities()"
  }
}